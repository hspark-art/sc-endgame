# starendgame.com 서버 설정 — /opt/starendgame/.env 로 복사해 채웁니다.
# 🔒 이 파일(.env)은 서버에만 있습니다. 저장소·채팅·메신저에 붙여넣지 마세요.

# 이 한 줄이 「서버 안 폴더 복사」를 켭니다. 네트워크도 비밀번호도 필요 없어집니다.
DEPLOY_LOCAL_DIR=/var/www/starendgame

# 유튜브 다시보기 자동 연결 — YouTube Data API 키 (GitHub 시크릿 YOUTUBE_API_KEY 와 같은 값)
YOUTUBE_API_KEY=

# 문제가 생겼을 때만 알림을 받을 슬랙 웹훅 — 새로 발급받은 주소를 넣어 주세요
SLACK_WEBHOOK_URL=
